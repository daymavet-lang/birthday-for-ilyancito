<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Para Ilyancito ✨</title>

<style>

* {
    box-sizing: border-box;
}

html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100%;
}

body {
    overflow-x: hidden;
    background:
        radial-gradient(circle at 50% 40%, #123b70 0%, #071a35 35%, #020814 75%);
    color: white;
    font-family: Arial, sans-serif;
}

/* ESTRELLAS */

.stars {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
}

.star {
    position: absolute;
    width: 3px;
    height: 3px;
    background: #8cc8ff;
    border-radius: 50%;
    animation: twinkle 2s infinite alternate;
}

.star:nth-child(1) { top: 10%; left: 15%; }
.star:nth-child(2) { top: 20%; left: 80%; animation-delay: .5s; }
.star:nth-child(3) { top: 35%; left: 10%; animation-delay: 1s; }
.star:nth-child(4) { top: 60%; left: 90%; animation-delay: .8s; }
.star:nth-child(5) { top: 75%; left: 20%; animation-delay: 1.3s; }
.star:nth-child(6) { top: 85%; left: 75%; animation-delay: .3s; }
.star:nth-child(7) { top: 15%; left: 50%; animation-delay: 1.5s; }
.star:nth-child(8) { top: 50%; left: 70%; animation-delay: .7s; }
.star:nth-child(9) { top: 70%; left: 50%; animation-delay: 1.1s; }
.star:nth-child(10) { top: 30%; left: 40%; animation-delay: .4s; }

@keyframes twinkle {
    from {
        opacity: .2;
        transform: scale(.7);
    }
    to {
        opacity: 1;
        transform: scale(1.5);
    }
}

/* CORAZONES */

.heart {
    position: fixed;
    bottom: -30px;
    font-size: 20px;
    opacity: 0;
    pointer-events: none;
    animation: floatHeart 7s linear infinite;
    z-index: 1;
}

.heart:nth-child(1) {
    left: 12%;
    animation-delay: 1s;
}

.heart:nth-child(2) {
    left: 30%;
    animation-delay: 3s;
}

.heart:nth-child(3) {
    left: 55%;
    animation-delay: 5s;
}

.heart:nth-child(4) {
    left: 78%;
    animation-delay: 2s;
}

@keyframes floatHeart {
    0% {
        transform: translateY(0) scale(.6) rotate(0deg);
        opacity: 0;
    }

    15% {
        opacity: .8;
    }

    100% {
        transform: translateY(-110vh) scale(1.2) rotate(25deg);
        opacity: 0;
    }
}

/* CONTENEDOR */

.container {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 700px;
    margin: auto;
    padding: 35px 20px 60px;
    text-align: center;
}

/* TITULO */

.small-title {
    color: #72baff;
    letter-spacing: 4px;
    font-size: 13px;
    margin-top: 10px;
    text-transform: uppercase;
}

h1 {
    font-size: 38px;
    margin: 12px 0 5px;
    text-shadow: 0 0 25px #218cff;
}

.subtitle {
    color: #a9c9e9;
    margin-bottom: 35px;
}

/* DISCO */

.record-area {
    position: relative;
    width: 300px;
    height: 300px;
    margin: 20px auto 35px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.glow {
    position: absolute;
    width: 280px;
    height: 280px;
    border-radius: 50%;
    background: #1688ff;
    filter: blur(55px);
    opacity: .35;
}

.record {
    position: relative;
    width: 265px;
    height: 265px;
    border-radius: 50%;

    background:
        repeating-radial-gradient(
            circle,
            #02050a 0px,
            #07111e 2px,
            #02050a 4px
        );

    box-shadow:
        0 0 15px #0b82ff,
        0 0 45px rgba(0, 132, 255, .45),
        inset 0 0 35px #000;

    animation: spin 8s linear infinite;
}

@keyframes spin {
    from {
        transform: rotate(0deg);
    }

    to {
        transform: rotate(360deg);
    }
}

/* REFLEJO DEL DISCO */

.record::before {
    content: "";
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 50%;

    background:
        linear-gradient(
            130deg,
            transparent 25%,
            rgba(90,190,255,.25) 45%,
            transparent 60%
        );
}

/* ETIQUETA DEL DISCO */

.label {
    position: absolute;
    width: 105px;
    height: 105px;
    border-radius: 50%;
    background:
        radial-gradient(circle, #79c7ff 0%, #1675c8 35%, #07366a 75%);
    top: 80px;
    left: 80px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 2px solid #9bd8ff;
    box-shadow: 0 0 20px rgba(67,170,255,.7);
}

.label-text {
    text-align: center;
    font-size: 11px;
    font-weight: bold;
    line-height: 1.4;
}

.hole {
    position: absolute;
    width: 12px;
    height: 12px;
    background: #020814;
    border-radius: 50%;
    top: 46px;
    left: 46px;
}

/* INFORMACION DE LA CANCION */

.song-info {
    margin-bottom: 30px;
}

.song-title {
    font-size: 25px;
    font-weight: bold;
}

.artist {
    color: #72baff;
    margin-top: 5px;
}

/* BOTON */

.music-button {
    display: inline-block;
    margin-top: 15px;
    padding: 13px 24px;
    border-radius: 30px;

    background: #1677d2;
    color: white;

    text-decoration: none;
    font-weight: bold;

    box-shadow: 0 0 20px rgba(28,133,235,.45);

    transition: .3s;
}

.music-button:hover {
    transform: scale(1.06);
    background: #218cff;
}

/* CARTA */

.card {
    margin-top: 45px;
    padding: 28px 25px;

    background: rgba(5, 20, 40, .82);
    border: 1px solid rgba(83,167,238,.4);
    border-radius: 20px;

    box-shadow:
        0 0 35px rgba(0,120,255,.15);

    text-align: left;
    backdrop-filter: blur(8px);
}

.card h2 {
    text-align: center;
    color: #79c7ff;
    margin-top: 0;
}

.letter {
    color: #d7e9f8;
    font-size: 16px;
    line-height: 1.9;
}

.signature {
    text-align: center;
    margin-top: 25px;
    color: #79c7ff;
    font-size: 18px;
}

/* MENSAJE FINAL */

.final {
    margin-top: 45px;
    font-size: 14px;
    color: #7295b8;
}

.final span {
    color: #64b8ff;
}

/* MOVIL */

@media (max-width: 500px) {

    .container {
        padding-top: 25px;
    }

    h1 {
        font-size: 30px;
    }

    .record-area {
        width: 270px;
        height: 270px;
    }

    .record {
        width: 235px;
        height: 235px;
    }

    .label {
        width: 95px;
        height: 95px;
        top: 70px;
        left: 70px;
    }

    .hole {
        top: 41px;
        left: 41px;
    }

    .card {
        padding: 23px 20px;
    }

    .letter {
        font-size: 15px;
    }
}

</style>
</head>

<body>

<!-- ESTRELLAS -->

<div class="stars">
    <div class="star"></div>
    <div class="star"></div>
    <div class="star"></div>
    <div class="star"></div>
    <div class="star"></div>
    <div class="star"></div>
    <div class="star"></div>
    <div class="star"></div>
    <div class="star"></div>
    <div class="star"></div>
</div>

<!-- CORAZONES -->

<div class="heart">💙</div>
<div class="heart">♡</div>
<div class="heart">💙</div>
<div class="heart">♡</div>

<div class="container">

    <div class="small-title">
        A little birthday record
    </div>

    <h1>Para Ilyancito ✨</h1>

    <div class="subtitle">
        Un pequeño disco hecho especialmente para ti.
    </div>

    <!-- DISCO -->

    <div class="record-area">

